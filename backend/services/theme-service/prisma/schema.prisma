generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Theme {
  id          String                 @id @default(uuid())
  name        String
  description String?                @db.Text
  price       Decimal                @db.Decimal(10, 2)
  createdAt   DateTime               @default(now()) @map("created_at")
  deletedAt   DateTime?              @map("deleted_at")
  categories  ThemeCategoryMapping[]

  @@map("themes")
}

model ThemeCategory {
  id          String                 @id @default(uuid())
  name        String                 @unique
  description String?                @db.Text
  themes      ThemeCategoryMapping[]

  @@map("theme_categories")
}

model ThemeCategoryMapping {
  themeId    String        @map("theme_id")
  categoryId String        @map("category_id")
  theme      Theme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  category   ThemeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([themeId, categoryId])
  @@map("theme_category_mapping")
}
